# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/better_auth_tutorial
DB_HOST=localhost
DB_PORT=5432
DB_PASSWORD=password
DB_USER=postgres
DB_NAME=better_auth_tutorial

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Social Providers
CLIENT_ID_DISCORD=
CLIENT_SECRET_DISCORD=
CLIENT_ID_GITHUB=
CLIENT_SECRET_GITHUB=

# Postmark
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# Encryption (Must be exactly 32 characters)
ENCRYPTION_SECRET=

# AI
# Embedding vector dimensions (must match pgvector column, 2048-dim)
EMBEDDING_DIMENSIONS=2048
# Documents per embedding batch request
EMBEDDING_BATCH_SIZE=96
# Max chat history turns sent to the model
CHAT_MAX_HISTORY_TURNS=50
# Knowledgebase hybrid search results per query
RAG_TOP_K=5
# Transform agent KB search results per knowledgebase
TRANSFORM_TOP_K=3
# Max characters extracted from a document before truncation
MAX_DOCUMENT_CHARS=500000
# Default chunk size in characters (~400 tokens)
DEFAULT_CHUNK_SIZE=1600
# Default overlap between adjacent chunks in characters
DEFAULT_CHUNK_OVERLAP=200
# Max AI tool-calling steps per chat/transform run
CHAT_MAX_STEPS=10
# Rate limits (requests per minute)
RATE_LIMIT_CHAT_RPM=20
RATE_LIMIT_UPLOAD_RPM=30

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-client-uploads
S3_REGION=us-east-1
# Use path-style S3 addressing (required for MinIO)
S3_FORCE_PATH_STYLE=true
# Allow local/private network MCP servers (for development)
ALLOW_PRIVATE_NETWORK_MCP=false
NEXT_PUBLIC_ENABLE_EMAIL_PASSWORD="false"